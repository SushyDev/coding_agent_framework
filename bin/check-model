#!/usr/bin/env bash
# Checks the TLA+ specs in model/tla with TLC. TLC comes from devenv:
#
#   devenv shell -- bin/check-model                every fast configuration, model/tla/*.cfg,
#                                                  and a parse of every slow one
#   devenv shell -- bin/check-model all            the same
#   devenv shell -- bin/check-model slow           every slow configuration, model/tla/slow/*.cfg
#   devenv shell -- bin/check-model Agent_Viewers               one configuration, by its name
#   devenv shell -- bin/check-model slow/Agent_RestartsWrites   one slow configuration
#
# TLC uses every core unless TLC_WORKERS names a number: TLC_WORKERS=2 bin/check-model
#
# The fast configurations finish in under 30 s each and run in the test gate. The slow ones are
# run by hand, and their times go in the build note. Each time is printed with the host's load,
# the 1-minute average read as that configuration starts, beside the core count. A fast
# configuration over 30 s fails when that load was under the core count; at or over it, the time
# says nothing about the configuration, and it is printed as not judged (F-238). The average
# also holds this run's own earlier TLC work, so it reads high rather than low: a slow
# configuration can go unjudged, and the idle timing the design asks of a unit that changes a
# spec still catches it; a loaded host never fails a configuration that is fast. `all` also parses every slow configuration:
# TLC reads the spec and the configuration and takes the initial state alone (a simulation one
# state deep), so a constant left unset or a name the spec lost fails here, not on the next run
# by hand.
#
# A configuration `<Spec>_<Scenario>.cfg` checks `<Spec>.tla`. One named `Break_<Spec>_<Bug>.cfg`
# sets the spec's `Break` constant to a deliberate bug: it passes only when TLC reports an
# invariant or a property violated (exit 12 or 13), which shows the check catches that bug. A
# parse error, a constant left unset, a deadlock or a Java error fails it. Every other
# configuration passes only when TLC finds no violation.
#
# Each prints its states, depth and seconds. TLC's output is in _build/tlc/<name>.out.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
specs="$root/model/tla"
out="$root/_build/tlc"
what="${1:-all}"

# Every program comes from devenv's lock: TLC by its path, and the text tools from a PATH that
# holds only them.
if [[ -z "${CAF_TLC:-}" || -z "${CAF_TOOLS_PATH:-}" ]]; then
  echo "check-model: CAF_TLC or CAF_TOOLS_PATH unset; run it inside devenv: devenv shell -- bin/check-model" >&2
  exit 2
fi
tlc="$CAF_TLC"
export PATH="$CAF_TOOLS_PATH"
cores=$(nproc)

# The 1-minute load average: /proc/loadavg on Linux, `sysctl -n vm.loadavg` (`{ 1.2 3.4 5.6 }`)
# on macOS, by devenv's sysctl.
load() {
  local one rest
  if [[ -r /proc/loadavg ]]; then
    read -r one rest </proc/loadavg
  elif [[ -n "${CAF_SYSCTL:-}" ]]; then
    read -r _ one rest <<<"$("$CAF_SYSCTL" -n vm.loadavg)"
  else
    one="?"
  fi
  echo "$one"
}

configs=()
parsed=()
case "$what" in
  all)
    configs=("$specs"/*.cfg)
    parsed=("$specs"/slow/*.cfg)
    ;;
  slow) configs=("$specs"/slow/*.cfg) ;;
  -h | --help)
    echo "usage: bin/check-model [all | slow | <configuration> | slow/<configuration>]"
    exit 0
    ;;
  *) configs=("$specs/$what.cfg") ;;
esac

for cfg in "${configs[@]}"; do
  if [[ ! -f "$cfg" ]]; then
    echo "check-model: no configuration $cfg" >&2
    exit 2
  fi
done

mkdir -p "$out"
failed=0

for cfg in "${configs[@]}"; do
  name="$(basename "$cfg" .cfg)"
  # Break_Agent_NoPaneCheck.cfg and Agent_Viewers.cfg both check Agent.tla.
  spec="${name#Break_}"
  spec="${spec%%_*}"
  relative="${cfg#"$specs"/}"
  echo "== $name ($spec.tla)"

  status=0
  under=$(load)
  started=$(date +%s)
  (cd "$specs" &&
    "$tlc" -workers "${TLC_WORKERS:-auto}" -cleanup -noGenerateSpecTE -metadir "$out/states-$name" \
      -config "$relative" "$spec.tla") >"$out/$name.out" 2>&1 || status=$?
  seconds=$(($(date +%s) - started))

  # The counts from TLC's own summary.
  states=$(grep -Eo '^[0-9,]+ states generated, [0-9,]+ distinct states found' "$out/$name.out" |
    tail -1 || true)
  depth=$(grep -Eo 'depth of the complete state graph search is [0-9]+' "$out/$name.out" |
    grep -Eo '[0-9]+$' || true)
  echo "   ${states:-no state count}; depth ${depth:-?}; ${seconds} s at load $under on $cores cores"

  # The 30 s rule, for a fast configuration, judged only under a load below the core count.
  if [[ "$relative" != slow/* && $seconds -gt 30 ]]; then
    if [[ "$under" == "?" ]]; then
      echo "   FAILED: over 30 s, and the load is unknown, so it cannot be judged"
      failed=1
    elif ((${under%.*} < cores)); then
      echo "   FAILED: over 30 s at load $under, under $cores cores; move it to slow/ or shrink it"
      failed=1
    else
      echo "   over 30 s at load $under, not under $cores cores: not judged"
    fi
  fi

  if [[ "$name" == Break_* ]]; then
    # TLC's exit status: 12 an invariant or action property violated, 13 a temporal property
    # violated, 0 none; 11 a deadlock, 150 a parse error, 151 a configuration error, 153 and 255
    # a Java or TLC error. Only a violation TLC reports is the counterexample.
    if [[ $status -eq 0 ]]; then
      echo "   FAILED: a deliberately broken design passed; the check does not catch it"
      failed=1
    elif [[ $status -eq 12 || $status -eq 13 ]] &&
      grep -qE "is violated|were violated" "$out/$name.out"; then
      grep -E "is violated|were violated" "$out/$name.out" | head -1 | sed 's/^/   /'
      echo "   ok: TLC found the counterexample (trace in _build/tlc/$name.out)"
    else
      echo "   FAILED: TLC exited $status with no violation; see _build/tlc/$name.out"
      failed=1
    fi
  elif [[ $status -ne 0 ]]; then
    grep -E "Error:|is violated|were violated" "$out/$name.out" | head -3 | sed 's/^/   /' || true
    echo "   FAILED: TLC exited $status; see _build/tlc/$name.out"
    failed=1
  else
    echo "   ok"
  fi
done

for cfg in "${parsed[@]}"; do
  name="$(basename "$cfg" .cfg)"
  spec="${name%%_*}"
  relative="${cfg#"$specs"/}"
  echo "== parse $relative ($spec.tla)"
  status=0
  (cd "$specs" &&
    "$tlc" -workers 1 -cleanup -noGenerateSpecTE -metadir "$out/states-parse-$name" \
      -simulate num=1 -depth 1 -config "$relative" "$spec.tla") >"$out/parse-$name.out" 2>&1 ||
    status=$?
  if [[ $status -eq 0 ]]; then
    echo "   ok"
  else
    grep -E "Error:|is violated|not assigned" "$out/parse-$name.out" | head -3 | sed 's/^/   /' || true
    echo "   FAILED: TLC exited $status; see _build/tlc/parse-$name.out"
    failed=1
  fi
done

exit $failed
